{
  "name": "sotto-desktop",
  "productName": "Sotto",
  "version": "0.1.0",
  "private": true,
  "description": "Sotto's desktop client: the overlay, sign-in, audio capture and the local history. The server holds the intelligence.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "predev:preview": "install-electron",
    "dev:preview": "electron-vite dev --mode preview",
    "build": "electron-vite build",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@microsoft/signalr-protocol-msgpack": "10.0.11",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "openid-client": "6.8.8",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
